doctype html
html lang="#{I18n.locale}" data-theme=active_theme
  head
    - public_download_title = content_for?(:title) ? yield(:title) : @title
    title = page_title(public_download_title.presence || t('public_downloads.title', default: 'App 下载中心'))
    meta charset="utf-8"
    meta name="viewport" content="width=device-width, initial-scale=1.0"
    link rel="apple-touch-icon" sizes="60x60" href="#{vite_asset_path('images/zealot-icon.png')}"
    link rel="apple-touch-icon" sizes="120x120" href="#{vite_asset_path('images/zealot-icon@2x.png')}"
    link rel="apple-touch-icon" sizes="180x180" href="#{vite_asset_path('images/zealot-icon@3x.png')}"
    link rel="icon" type="image/x-icon" href="#{vite_asset_path('images/zealot-icon@3x.png')}"
    == favicon_link_tag vite_asset_path('images/zealot-icon.png')
    == favicon_link_tag vite_asset_path('images/zealot-icon-dark.png'), media: '(prefers-color-scheme: dark)'
    == vite_stylesheet_tag 'application', 'data-turbolinks-track': 'reload'
    == vite_javascript_tag 'application', defer: true, type: :module, 'data-turbolinks-track': 'reload'
    == yield :header_tags
    == csrf_meta_tags

  body
    header.public-downloads__canvas-topbar
      .public-downloads__canvas-topbar-inner
        = link_to public_download_apps_path, class: 'public-downloads__canvas-brand'
          span.public-downloads__canvas-brand-title = t('public_downloads.title', default: 'App 下载中心')
          span.public-downloads__canvas-brand-route = public_download_title.presence || '/download_apps'
        .public-downloads__canvas-topbar-actions
          = link_to t('dashboard.title'),
                    root_path,
                    class: 'public-downloads__canvas-topbar-link',
                    data: { turbo_frame: '_top' }

    - if flash.any?
      .public-downloads__canvas-flashes
        - flash.each do |type, message|
          .public-downloads__canvas-flash class="public-downloads__canvas-flash--#{type}"
            = message

    == yield

    == turbo_frame_tag :modal
