- app = release.app
- scheme = release.scheme

.public-downloads__canvas-password-wrap
  .public-downloads__canvas-password-stack
    .public-downloads__canvas-password-hero
      == public_download_release_icon(release, app: app, size: :xl)
      h1.public-downloads__canvas-password-appname = public_download_app_name(app)
      .public-downloads__canvas-password-pills
        span.public-downloads__canvas-pill = public_download_platform_label(release)
        span.public-downloads__canvas-pill.public-downloads__canvas-pill--warn = public_download_scheme_name(scheme)
      p.public-downloads__canvas-password-sub
        = "#{public_download_version_label(release, prefix: true)} · #{public_download_build_label(release)}"

    article.public-downloads__canvas-auth-card
      h2.public-downloads__canvas-auth-title = t('public_downloads.password_title', default: '访问验证')
      p.public-downloads__canvas-auth-lead = t('public_downloads.password_description', default: '该应用设置了访问密码，请输入密码以继续')

      - if error_message.present?
        .public-downloads__canvas-auth-error
          = error_message

      = form_with url: public_download_auth_path(release, channel), method: :post, class: 'public-downloads__canvas-auth-form' do |form|
        = form.label :password, t('public_downloads.password_label', default: '访问密码'), class: 'public-downloads__canvas-label'
        = form.password_field :password,
                              class: 'public-downloads__canvas-input',
                              autocomplete: 'current-password',
                              placeholder: t('public_downloads.password_placeholder', default: '请输入访问密码'),
                              autofocus: true
        button.public-downloads__canvas-btn.public-downloads__canvas-btn--primary.public-downloads__canvas-btn--block type="submit"
          = t('public_downloads.password_submit', default: '确认访问')
