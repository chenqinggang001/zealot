# Check enviroment varibles document:
# https://zealot.ews.im/docs/self-hosted/configuration/environment-variables
#
# Sample .env file:
# https://github.com/tryzealot/zealot-docker/blob/main/config.env

# --- S3-compatible object storage (Huawei OBS / MinIO / Aliyun OSS / Tencent COS / AWS S3) ---
# STORAGE_S3_ENABLED=false
# STORAGE_S3_ENDPOINT=https://obs.cn-north-4.myhuaweicloud.com
# STORAGE_S3_REGION=cn-north-4
# STORAGE_S3_BUCKET=
# STORAGE_S3_ACCESS_KEY_ID=
# STORAGE_S3_SECRET_ACCESS_KEY=
# STORAGE_S3_FORCE_PATH_STYLE=false    # set true for MinIO
# STORAGE_S3_PATH_PREFIX=               # optional, e.g. zealot-prod
# STORAGE_S3_OBJECT_ACL=private
# STORAGE_S3_PRESIGN_EXPIRES_IN=3600
